{
  "name": "ah-at-ng",
  "description": "Test automation framework for API testing with Playwright and Jest",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "env:test": "ENVIRONMENT=test npm run test",
    "env:dev": "ENVIRONMENT=dev npm run test",
    "test": "npm run cleandir && jest --runInBand --testResultsProcessor=\"jest-junit\" --detectOpenHandles --forceExit",
    "testMatching": "npm run cleandir && jest --runInBand --testResultsProcessor=\"jest-junit\" --detectOpenHandles --forceExit --testNamePattern",
    "dryTest": "npm run cleandir && jest --listTests --runInBand --testResultsProcessor=\"jest-junit\" --detectOpenHandles",
    "perftest": "npm run cleandir && TRACE_API_CALLS=false  jest --runInBand --testResultsProcessor=\"jest-junit\" --roots=\"./src/perftests\"  --detectOpenHandles --forceExit",
    "cleandir": "cleandir ./allure-results",
    "processKnownIssues": "./process_known_issues.sh",
    "report": "allure serve",
    "pw-test": "npx playwright test --reporter=allure-playwright",
    "pw-report": "npx playwright show-report"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "ajv": "^8.17.1",
    "axios": "^1.13.1",
    "date-fns": "^4.1.0",
    "eslint": "^8.43.0",
    "file-saver": "^2.0.5",
    "googleapis": "^105.0.0",
    "jest-config": "^29.5.0",
    "node-xlsx": "^0.24.0",
    "object-to-formdata": "^4.5.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.57.0",
    "properties-file": "^2.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@mstssk/cleandir": "^2.0.0",
    "@playwright/test": "^1.49.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/jest-json-schema": "^6.1.4",
    "@types/node": "^20.2.5",
    "@types/supertest": "^6.0.2",
    "allure-commandline": "^2.36.0",
    "allure-jest": "^3.4.3",
    "allure-playwright": "^3.4.3",
    "jest": "^30.2.0",
    "jest-circus": "^30.2.0",
    "jest-ctrf-json-reporter": "^0.0.9",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^30.2.0",
    "jest-json-schema": "^6.1.0",
    "jest-junit": "^16.0.0",
    "jest-openapi-coverage": "^1.4.0",
    "npm-run-all": "^4.1.5",
    "pg-promise": "^11.10.2",
    "rimraf": "^5.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.3"
  }
}
